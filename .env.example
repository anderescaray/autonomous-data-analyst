# ── LLM provider ──────────────────────────────────────────────────────────────
# Which provider to use: "openai" | "anthropic"
LLM_PROVIDER=openai

# Model name (optional — defaults shown below)
#   openai default:    gpt-4o
#   anthropic default: claude-opus-4-8
# LLM_MODEL=gpt-4o

# ── API keys (only the key for your chosen provider is required) ───────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
